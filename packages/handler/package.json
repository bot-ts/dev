{
  "name": "@ghom/handler",
  "version": "3.1.0",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "File handler with real hot-reload for Node.js",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "ci": "biome ci .",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write --unsafe .",
    "build": "rimraf dist .build.tsbuildinfo && tsc --tsBuildInfoFile .build.tsbuildinfo",
    "prepublishOnly": "bun run format && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/md5": "^2.3.5",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "md5": "^2.3.0"
  }
}
