{
  "compilerOptions": {
    "strict": true,
    "outDir": "dist",
    "rootDir": "../../",
    "module": "esnext",
    "target": "ES2022",
    "lib": ["ES2023"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "#config": ["../../apps/framework/src/config.ts"],
      "#types": ["../../apps/framework/src/types.ts"],
      "#core/*": ["./src/*"],
      "#buttons/*": ["../../apps/framework/src/buttons/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["tests/**/*"]
}
