{
  "name": "@ghom/bot.ts-core",
  "version": "10.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Core system elements for bot.ts framework",
  "homepage": "https://github.com/bot-ts/framework",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./src/*.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "format": "biome check --write --unsafe .",
    "ci": "biome ci .",
    "check": "biome check . && tsc --noEmit",
    "build": "rimraf dist .build.tsbuildinfo && tsc -p tsconfig.build.json --tsBuildInfoFile .build.tsbuildinfo",
    "prepublishOnly": "bun run check && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@discordjs/collection": "^1.5.3",
    "@ghom/handler": "workspace:*",
    "@ghom/logger": "workspace:*",
    "@ghom/orm": "workspace:*",
    "@types/node-cron": "^3.0.11",
    "@types/yargs-parser": "^21.0.3",
    "dayjs": "^1.11.13",
    "discord-api-types": "^0.38.40",
    "discord-eval.ts": "1.1.4",
    "discord.js": "14.26.4",
    "dotenv": "^16.5.0",
    "node-cron": "^3.0.3",
    "regex-parser": "^2.3.1",
    "simple-git": "^3.27.0",
    "tims": "^2.1.0",
    "types-package-json": "^2.0.39",
    "yargs-parser": "^21.1.1",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
