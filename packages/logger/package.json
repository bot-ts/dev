{
  "name": "@ghom/logger",
  "version": "2.0.2",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "TypeScript logger",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "ci": "biome ci .",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write --unsafe .",
    "build": "rimraf dist .build.tsbuildinfo && tsc --tsBuildInfoFile .build.tsbuildinfo",
    "prepublishOnly": "bun run format && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "=4.1.2",
    "dayjs": "^1.11.13"
  }
}
