{
  "name": "@ghom/event-emitter",
  "version": "1.2.1",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Suitable to be included in a bundle for Node and the browser for emit events (Node EventEmitter-like)",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "ci": "biome ci .",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write --unsafe .",
    "build": "rimraf dist .build.tsbuildinfo && tsc --tsBuildInfoFile .build.tsbuildinfo",
    "prepublishOnly": "bun run format && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}
