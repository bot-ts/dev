{
  "name": "@ghom/query",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "TypeScript query manager (caching, throttling, retry, debounce, dedup, circuit breaker, timeout, batching)",
  "homepage": "https://github.com/GhomKrosmonaute/query",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GhomKrosmonaute/query.git"
  },
  "keywords": [
    "query",
    "cache",
    "caching",
    "throttle",
    "throttling",
    "retry",
    "debounce",
    "dedup",
    "deduplication",
    "circuit-breaker",
    "timeout",
    "batching",
    "dataloader",
    "api",
    "fetch",
    "request"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "ci": "biome ci .",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write --unsafe .",
    "build": "rimraf dist .build.tsbuildinfo && tsc --tsBuildInfoFile .build.tsbuildinfo",
    "test": "tsc --noEmit && bun test",
    "prepublishOnly": "bun run format && bun run build && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
