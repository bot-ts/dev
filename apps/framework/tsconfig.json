{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "esnext",
		"target": "ES2020",
		"lib": ["ES2023"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"incremental": true,
		"types": ["node", "bun", "deno"],
		"tsBuildInfoFile": ".tsbuildinfo",
		"sourceMap": true,
		"declaration": false,
		"esModuleInterop": true,
		"noImplicitOverride": true,
		"allowImportingTsExtensions": false,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"#config": ["./src/config.ts"],
			"#types": ["./src/types.ts"],

			"#core/*": ["./node_modules/@ghom/bot.ts-core/src/*"],

			"#tables/*": ["./src/tables/*"],
			"#buttons/*": ["./src/buttons/*"],
			"#namespaces/*": ["./src/namespaces/*"],
			"#modules/*": ["./src/modules/*"],

			"#all": ["./node_modules/@ghom/bot.ts-core/src/index.ts"]
		}
	},
	"include": ["src/**/*"]
}
