import { Table } from "@ghom/orm"

/**
 * See the {@link https://ghom.gitbook.io/bot.ts/usage/use-database database guide} for more information.
 */
export default new Table({
  name: "<%= name %>",
  description: "<%- description %>",<% if (priority) { %>
  priority: <%= priority %>,<% } %>
  columns: (col) => ({
<%- Object.entries(columns).map(([name, column]) => {
  let line = `    ${name}: col.`
  if (column.category === "primary") {
    if (column.auto) {
      line += "increments()"
    } else {
      const method = column.typeFn === "bigint" ? "bigInteger" : column.typeFn
      line += `${method}().primary()`
    }
  } else if (column.category === "relation") {
    const method = column.typeFn === "bigint" ? "bigInteger" : column.typeFn
    line += `${method}()`
    if (column.typeFn === "integer") {
      line += ".unsigned()"
    }
    line += `.references("${column.tableColumn}").inTable("${column.tableName}")`
    if (column.deleteCascade) {
      line += '.onDelete("CASCADE")'
    }
  } else if (column.category === "data") {
    const method = column.typeFn === "bigint" ? "bigInteger" : column.typeFn
    line += `${method}()`
    if (!column.required) {
      line += ".nullable()"
    }
    if (column.unique) {
      line += ".unique()"
    }
  }
  return line
}).join(",\n") %>
  }),
})
